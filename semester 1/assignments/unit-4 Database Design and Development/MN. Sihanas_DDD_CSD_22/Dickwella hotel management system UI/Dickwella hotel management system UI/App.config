<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>

<connectionStrings>
	<add name="HotelManagementConnectionString"
         connectionString="Data Source=.\MSSQLSERVER;Initial Catalog=HotelManagementSystem;Integrated Security=True"
         providerName="System.Data.SqlClient" />
</connectionStrings>
	
</configuration>